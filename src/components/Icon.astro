---
type Props = { name: string; class?: string };
const { name, class: className } = Astro.props;

// 20×20 line icons, stroked in currentColor so they follow the text colour.
const PATHS: Record<string, string> = {
  people: "M7 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5 8a5 5 0 0 1 10 0M14 9a2.5 2.5 0 1 0 0-5M15 12.2A4.5 4.5 0 0 1 18 17",
  display: "M3 4h14v9H3zM10 13v3M6 16h8",
  whiteboard: "M2 3h16v11H2zM6 17l2-3M14 17l-2-3M5 7c2-1 3 2 5 1s3-2 5-1",
  video: "M2 6h11v8H2zM13 9l5-3v8l-5-3",
  power: "M11 2 5 11h5l-1 7 6-9h-5z",
  pinup: "M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM11 11h6v6h-6z",
  "step-free": "M10 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM8 6h3v5h4l2 5M8 8a5 5 0 1 0 5 8",
  pin: "M10 18s6-5.3 6-10a6 6 0 0 0-12 0c0 4.7 6 10 6 10Zm0-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
  clock: "M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM10 6v4l3 2",
  calendar: "M3 5h14v12H3zM3 9h14M7 3v4M13 3v4",
  check: "M4 10.5 8 14.5 16 5.5",
  cross: "M5 5l10 10M15 5 5 15",
  arrow: "M4 10h12M11 5l5 5-5 5",
  close: "M5 5l10 10M15 5 5 15",
  screen: "M2 3h16v11H2zM7 17h6",
};
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 20 20"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[name] ?? ""}></path>
</svg>
