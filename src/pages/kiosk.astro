---
import { roomStatus, statusText } from "../lib/board";
import { listBookings, listRooms, nowLocal } from "../lib/db";
import "../styles.css";

// A door display: one room, full screen, readable from across a corridor.
const rooms = listRooms();
const roomId = Number(Astro.url.searchParams.get("room")) || rooms[0].id;
const room = rooms.find((r) => r.id === roomId) ?? rooms[0];
const now = nowLocal();
const today = now.slice(0, 10);
const roomBookings = listBookings()
  .filter((b) => b.roomId === room.id)
  .map(({ roomId, pod, startsAt, endsAt }) => ({ roomId, pod, startsAt, endsAt }));
const status = roomStatus(roomBookings, now);
const upcoming = roomBookings.filter((b) => b.endsAt > now && b.startsAt.slice(0, 10) === today);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{room.name} · Door display</title>
  </head>
  <body class={`kiosk ${status.state}`}>
    <nav aria-label="site">
      <a href="/">Crit Rooms</a>
      {
        rooms.map((r) => (
          <a href={`/kiosk/?room=${r.id}`} aria-current={r.id === room.id ? "page" : undefined}>
            {r.name.split(" — ").pop()}
          </a>
        ))
      }
    </nav>
    <main class="kiosk-main" data-room-id={room.id}>
      <img src={`/rooms/${room.id}.svg`} alt="" width="320" height="180" class="kiosk-img" />
      <div>
        <h1>{room.name}</h1>
        <p class="kiosk-state" aria-live="polite">
          <span id="kiosk-word">{status.state === "free" ? "FREE" : "IN USE"}</span>
          <span id="kiosk-detail" class="kiosk-detail">{statusText(status, now)}</span>
        </p>
        <h2>Still to come today</h2>
        <ul id="kiosk-upcoming" class="kiosk-upcoming">
          {
            upcoming.length === 0 ? (
              <li>Nothing else booked today.</li>
            ) : (
              upcoming.map((b) => (
                <li>
                  {b.startsAt.slice(11, 16)}–{b.endsAt.slice(11, 16)} · {b.pod}
                </li>
              ))
            )
          }
        </ul>
        <p class="kiosk-clock">Updated <span id="kiosk-time">{now.slice(11, 16)}</span></p>
      </div>
    </main>
    <script
      is:inline
      type="application/json"
      id="kiosk-data"
      set:html={JSON.stringify(roomBookings).replace(/</g, "\\u003c")}
    />
    <script>
      import { type BoardBooking, nowLocal, roomStatus, statusText } from "../lib/board";

      const main = document.querySelector<HTMLElement>(".kiosk-main");
      const roomId = Number(main?.dataset.roomId);
      const mine: BoardBooking[] = JSON.parse(
        document.querySelector("#kiosk-data")?.textContent ?? "[]",
      );

      function render() {
        const now = nowLocal();
        const status = roomStatus(mine, now);
        document.body.classList.toggle("free", status.state === "free");
        document.body.classList.toggle("busy", status.state === "busy");
        const word = document.querySelector("#kiosk-word");
        if (word) word.textContent = status.state === "free" ? "FREE" : "IN USE";
        const detail = document.querySelector("#kiosk-detail");
        if (detail) detail.textContent = statusText(status, now);
        const time = document.querySelector("#kiosk-time");
        if (time) time.textContent = now.slice(11, 16);
        const list = document.querySelector("#kiosk-upcoming");
        const upcoming = mine
          .filter((b) => b.endsAt > now && b.startsAt.slice(0, 10) === now.slice(0, 10))
          .sort((a, b) => a.startsAt.localeCompare(b.startsAt));
        list?.replaceChildren(
          ...(upcoming.length
            ? upcoming.map((b) => {
                const li = document.createElement("li");
                li.textContent = `${b.startsAt.slice(11, 16)}–${b.endsAt.slice(11, 16)} · ${b.pod}`;
                return li;
              })
            : [Object.assign(document.createElement("li"), { textContent: "Nothing else booked today." })]),
        );
      }

      new EventSource("/api/events").addEventListener("message", (event) => {
        const booking = JSON.parse(event.data);
        if (booking.roomId !== roomId) return;
        mine.push(booking);
        render();
      });
      setInterval(render, 30_000);
    </script>
  </body>
</html>
