---
import BookingSheet from "../components/BookingSheet.astro";
import Icon from "../components/Icon.astro";
import RoomCard from "../components/RoomCard.astro";
import SearchPanel from "../components/SearchPanel.astro";
import Base from "../layouts/Base.astro";
import { conflictIn, suggestSlot } from "../lib/board";
import { listBookings, listRooms, nowLocal } from "../lib/db";
import { fmtDate, fmtDay, fmtDuration, fmtRange, fmtTime } from "../lib/format";
import { readMine } from "../lib/mine";
import { bookHref, parseSearch, rankRooms, searchHref } from "../lib/search";
import { detailsFor } from "../lib/spaces";

const rooms = listRooms();
const bookings = listBookings();
const now = nowLocal();
const params = Astro.url.searchParams;
const search = parseSearch(params, now);
const results = rankRooms(rooms, bookings, search);
const shown = results.filter((r) => r.fits);
const hiddenCount = results.length - shown.length;
const freeShown = shown.filter((r) => r.available);

// --- the booking sheet: opened by a selection link or a rejected POST ---
const errorCode = params.get("error") ?? undefined;
const selRoomId = Number(params.get("roomId")) || undefined;
const sheetOpen = Boolean(errorCode || selRoomId);
const selRoom = rooms.find((r) => r.id === selRoomId);
const values = {
  pod: params.get("pod") ?? "",
  tutor: params.get("tutor") ?? "",
  startsAt: params.get("startsAt") ?? "",
  endsAt: params.get("endsAt") ?? "",
};
const validSel = /T\d\d:\d\d$/.test(values.startsAt) && values.startsAt < values.endsAt;
const selBookings = bookings.filter((b) => b.roomId === selRoomId);
const taken = selRoom && validSel ? conflictIn(selBookings, values.startsAt, values.endsAt) : undefined;
const duration = search.duration;
const alternatives: { label: string; href: string }[] = [];
if (selRoom && validSel && taken) {
  const same = suggestSlot(selBookings, values.startsAt, duration, duration);
  alternatives.push({
    label: `${detailsFor(selRoom).room} at ${fmtTime(same.startsAt)}${same.startsAt.slice(0, 10) !== values.startsAt.slice(0, 10) ? ` on ${fmtDate(same.startsAt.slice(0, 10))}` : ""}`,
    href: bookHref(search, selRoom.id, same),
  });
  for (const r of results.filter((x) => x.available && x.room.id !== selRoom.id).slice(0, 2)) {
    alternatives.push({
      label: `${r.details.room}, ${r.details.building} at ${fmtTime(values.startsAt)}`,
      href: bookHref(search, r.room.id, { startsAt: values.startsAt, endsAt: values.endsAt }),
    });
  }
}
const closeHref = `${searchHref(search, {})}#results`;

// --- the side panel when nothing is selected: this browser's next bookings ---
const mineIds = new Set(readMine(Astro.cookies).map((m) => m.id));
const myNext = bookings
  .filter((b) => mineIds.has(b.id) && b.endsAt > now)
  .slice(0, 3);

// --- empty state helpers ---
const soonest = [...shown].sort((a, b) => a.next.startsAt.localeCompare(b.next.startsAt))[0];
const shorter = [30, 60, 90, 120].filter((d) => d < duration).pop();

const dayWord = fmtDay(search.start, now);
const dayPhrase = dayWord === "Today" ? "today" : dayWord === "Tomorrow" ? "tomorrow" : `on ${dayWord}`;
const nextDay = (ts: string) => (fmtDay(ts, now) === "Today" ? "" : `${fmtDay(ts, now)} `);

const title = sheetOpen && selRoom ? `Book ${detailsFor(selRoom).room} · Crit Rooms` : "Find a space · Crit Rooms";
---

<Base title={title} active="find" bodyClass={sheetOpen ? "sheet-open" : undefined}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="overline overline-gold">Crit rooms · Semester 2</p>
        <h1 id="hero-heading">Find a room.<br />Book it.<br /><span class="hero-soft">Get on with the crit.</span></h1>
        <p class="hero-lede">
          Every crit room on campus, with the whole day's availability at a glance.
          Clashes are refused before anyone walks across campus to find out.
        </p>
        <p class="hero-stat" id="hero-stat">
          <strong>{results.filter((r) => r.available).length} of {rooms.length}</strong> rooms free {dayPhrase} at {fmtTime(search.start)}
        </p>
      </div>
      <SearchPanel search={search} now={now} />
    </div>
  </section>

  <div class="wrap layout">
    <section id="results" class="results" aria-labelledby="results-heading" aria-busy="false">
      <header class="results-head">
        <h2 id="results-heading">
          {
            shown.length === 0
              ? "No spaces match"
              : freeShown.length === 0
                ? "Nothing free for this time"
                : `${freeShown.length} ${freeShown.length === 1 ? "space" : "spaces"} free`
          }
        </h2>
        <p class="results-context">
          <Icon name="calendar" /> {fmtRange(search.start, search.end, now)}
          <span class="dot-sep">·</span> {fmtDuration(search.duration)}
          {search.people > 0 && <><span class="dot-sep">·</span> {search.people}+ people</>}
        </p>
        <ul class="legend" aria-label="Timeline key">
          <li><span class="key key-free" aria-hidden="true" /> Available</li>
          <li><span class="key key-booked" aria-hidden="true" /> Booked</li>
          <li><span class="key key-sel" aria-hidden="true" /> Your time</li>
          <li><span class="key key-past" aria-hidden="true" /> Past</li>
        </ul>
      </header>

      {
        search.movedFromPast && (
          <p class="notice notice-info" role="status">
            That time has already passed, so this shows availability from {fmtTime(search.start)} today.
          </p>
        )
      }

      {
        shown.length > 0 && freeShown.length === 0 && soonest && (
          <div class="empty">
            <p class="empty-title">Every matching room is taken {fmtTime(search.start)} – {fmtTime(search.end)}.</p>
            <div class="empty-actions">
              <a class="btn btn-primary" href={bookHref(search, soonest.room.id, soonest.next)}>
                Next available: {soonest.details.room}, {nextDay(soonest.next.startsAt)}{fmtTime(soonest.next.startsAt)}
              </a>
              {shorter && <a class="btn btn-secondary" href={`${searchHref(search, { duration: String(shorter) })}#results`}>Try {fmtDuration(shorter)}</a>}
              <a class="btn btn-ghost" href="#finder-heading">Change time</a>
            </div>
          </div>
        )
      }

      {
        shown.length === 0 && (
          <div class="empty">
            <p class="empty-title">No room fits all of those filters.</p>
            <div class="empty-actions">
              <a class="btn btn-primary" href={`${searchHref(search, { people: undefined, building: undefined, facility: undefined })}#results`}>Clear filters</a>
            </div>
          </div>
        )
      }

      <div class="space-list">
        {
          shown.map((result) => (
            <RoomCard result={result} search={search} now={now} selected={result.room.id === selRoomId} />
          ))
        }
      </div>

      {
        hiddenCount > 0 && shown.length > 0 && (
          <p class="hidden-note">
            {hiddenCount} {hiddenCount === 1 ? "room doesn't" : "rooms don't"} match your filters.{" "}
            <a href={`${searchHref(search, { people: undefined, building: undefined, facility: undefined })}#results`}>Show all rooms</a>
          </p>
        )
      }
    </section>

    <div class="side">
      {
        sheetOpen ? (
          <BookingSheet
            rooms={rooms}
            roomId={selRoom?.id}
            details={selRoom ? detailsFor(selRoom) : undefined}
            values={values}
            error={errorCode}
            taken={taken}
            alternatives={alternatives}
            now={now}
            closeHref={closeHref}
          />
        ) : (
          <section class="side-card" aria-labelledby="side-heading">
            {myNext.length > 0 ? (
              <>
                <p class="overline">From this browser</p>
                <h2 id="side-heading">Your next bookings</h2>
                <ul class="mini-list">
                  {myNext.map((b) => (
                    <li>
                      <a href={`/booking/${b.id}/`}>
                        <span class="mini-when">{fmtDay(b.startsAt, now)}, {fmtTime(b.startsAt)}</span>
                        <span class="mini-where">{detailsFor({ id: b.roomId, name: b.roomName }).room} · {b.pod}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="space-link" href="/mine/">All my bookings <Icon name="arrow" /></a>
              </>
            ) : (
              <>
                <p class="overline">How it works</p>
                <h2 id="side-heading">Three steps, no accounts</h2>
                <ol class="steps">
                  <li><strong>Set a time.</strong> Date, start and how long — the rooms re-sort around it.</li>
                  <li><strong>Pick a room.</strong> Hatched blocks are taken; the gold outline is your time.</li>
                  <li><strong>Confirm.</strong> Add your pod's name. It's in the calendar for everyone, instantly.</li>
                </ol>
              </>
            )}
          </section>
        )
      }
    </div>
  </div>

  <section class="wrap ledger" aria-labelledby="ledger-heading">
    <h2 id="ledger-heading">Booking ledger</h2>
    <p class="muted">Every booking across every room, oldest first.</p>
    {
      bookings.length === 0 ? (
        <p class="empty-title">No bookings yet — the first one's yours.</p>
      ) : (
        <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table of all bookings">
          <table>
            <thead>
              <tr>
                <th scope="col">Room</th>
                <th scope="col">Pod</th>
                <th scope="col">Tutor</th>
                <th scope="col">Starts</th>
                <th scope="col">Ends</th>
                <th scope="col">Calendar</th>
              </tr>
            </thead>
            <tbody id="schedule">
              {/* "(past)" is the real signal; the dimming is a bonus (WCAG 1.4.1). */}
              {bookings.map((booking) => {
                const isPast = booking.endsAt < now;
                return (
                  <tr class={isPast ? "past" : undefined}>
                    <td>{booking.roomName}</td>
                    <td>{booking.pod}</td>
                    <td>{booking.tutor ?? "—"}</td>
                    <td>{booking.startsAt.replace("T", " ")}</td>
                    <td>
                      {booking.endsAt.replace("T", " ")}
                      {isPast && " (past)"}
                    </td>
                    <td>
                      <a href={`/api/calendar/${booking.id}`} download>
                        .ics<span class="visually-hidden"> for {booking.pod} in {booking.roomName}</span>
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
</Base>

<script>
  import "../scripts/live-page";
</script>
