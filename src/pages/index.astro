---
import {
  earliestRoom,
  nowPosition,
  roomStatus,
  statusText,
  suggestSlot,
  timelineBlocks,
} from "../lib/board";
import { listBookings, listRooms, nowLocal } from "../lib/db";
import "../styles.css";

const rooms = listRooms();
const bookings = listBookings();

const ERROR_TEXT: Record<string, string> = {
  missing: "Every field is required.",
  "unknown-room": "That room doesn't exist.",
  "bad-format": "That doesn't look like a valid date and time.",
  "too-long": "Pod and tutor names can't be longer than 80 characters.",
  "bad-range": "The booking has to end after it starts.",
  conflict: "That room is already booked for part of that time.",
};
const errorCode = Astro.url.searchParams.get("error");
const errorRoomId = Astro.url.searchParams.get("roomId");
const errorRoomName = errorRoomId
  ? rooms.find((room) => room.id === Number(errorRoomId))?.name
  : undefined;

// On a rejected submission, refill the form from what was actually sent —
// see api/bookings.ts's withInput — rather than making someone retype every
// field over a single bad one (WCAG 2.2 SC 3.3.7, Redundant Entry).
const resubmitPod = Astro.url.searchParams.get("pod") ?? "";
const resubmitTutor = Astro.url.searchParams.get("tutor") ?? "";
const resubmitStartsAt = Astro.url.searchParams.get("startsAt") ?? "";
const resubmitEndsAt = Astro.url.searchParams.get("endsAt") ?? "";

const now = nowLocal();
const today = now.slice(0, 10);
const board = rooms.map((room) => {
  const roomBookings = bookings.filter((b) => b.roomId === room.id);
  const status = roomStatus(roomBookings, now);
  const slot = suggestSlot(roomBookings, now);
  const bookHref = `/?${new URLSearchParams({ roomId: String(room.id), ...slot })}#book`;
  return {
    room,
    status,
    text: statusText(status, now),
    blocks: timelineBlocks(roomBookings, today),
    bookHref,
  };
});
const freeCount = board.filter((r) => r.status.state === "free").length;
const nowAt = nowPosition(now);
const NEED_OPTIONS = [30, 60, 90, 120];
const needParam = Number(Astro.url.searchParams.get("need"));
const need = NEED_OPTIONS.includes(needParam) ? needParam : undefined;
const match = need ? earliestRoom(rooms, bookings, now, need) : undefined;
const matchHref = match
  ? `/?${new URLSearchParams({ roomId: String(match.room.id), startsAt: match.startsAt, endsAt: match.endsAt })}#book`
  : undefined;
const boardData = bookings.map(({ roomId, pod, startsAt, endsAt }) => ({
  roomId,
  pod,
  startsAt,
  endsAt,
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crit Rooms</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Crit Rooms</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <img
        class="hero"
        src="/hero.svg"
        alt="Illustrated campus skyline with lit windows: green for free rooms, red for booked ones"
        width="800"
        height="160"
      />
      <h1>Crit Rooms</h1>
      <p>
        Book one of the course's crit rooms for a pod's session. Two pods can't
        book the same room for overlapping times — the form below checks
        before it accepts anything, so nobody finds out in person.
      </p>

      <section aria-labelledby="board-heading">
        <h2 id="board-heading">Right now</h2>
        <p class="summary" id="free-summary" aria-live="polite">
          <strong>{freeCount} of {rooms.length}</strong> rooms free at {now.slice(11, 16)}
        </p>
        <form method="get" action="/#finder" class="finder" id="finder" aria-labelledby="finder-heading">
          <h3 id="finder-heading">Find me a room</h3>
          <fieldset>
            <legend>I need it for</legend>
            {
              NEED_OPTIONS.map((m) => (
                <label class="chip">
                  <input type="radio" name="need" value={m} checked={need === m || (!need && m === 60)} />
                  {m < 60 ? `${m} min` : `${m / 60} h`.replace(".5 h", "½ h")}
                </label>
              ))
            }
          </fieldset>
          <button>Find the soonest slot</button>
          {
            match && matchHref && (
              <p class="match" role="status">
                Soonest {need}-minute slot:{" "}
                <strong>{match.room.name}</strong>,{" "}
                {match.startsAt.slice(0, 10) === today ? "today" : match.startsAt.slice(0, 10)}{" "}
                {match.startsAt.slice(11, 16)}–{match.endsAt.slice(11, 16)}.{" "}
                <a href={matchHref}>Book it</a>
              </p>
            )
          }
        </form>
        <ul class="board" id="board">
          {
            board.map(({ room, status, text, blocks, bookHref }) => (
              <li class={`card ${status.state}`} data-room-id={room.id}>
                <img src={`/rooms/${room.id}.svg`} alt="" width="320" height="180" />
                <div class="card-body">
                  <h3>{room.name}</h3>
                  <p class="status">
                    <span class="dot" aria-hidden="true" />
                    <span class="status-text">{text}</span>
                  </p>
                  <div class="timeline" role="img" aria-label={`Today's bookings for ${room.name}: ${blocks.length ? blocks.map((b) => b.label).join(", ") : "none"}`}>
                    {blocks.map((b) => (
                      <span class="block" style={`left:${b.left}%;width:${b.width}%`} title={b.label} />
                    ))}
                    {nowAt !== undefined && <span class="now" style={`left:${nowAt}%`} />}
                  </div>
                  <div class="timeline-scale" aria-hidden="true">
                    <span>08</span><span>11</span><span>14</span><span>17</span><span>20</span>
                  </div>
                  <div class="card-links">
                    <a class="book-link" href={bookHref}>
                      Book {room.name.split(" — ").pop()}
                      <span class="visually-hidden"> ({room.name}), next free hour</span>
                    </a>
                    <a href={`/kiosk/?room=${room.id}`}>
                      Door display<span class="visually-hidden"> for {room.name}</span>
                    </a>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      {
        errorCode && (
          <p role="alert" class="error">
            {ERROR_TEXT[errorCode] ?? "That booking couldn't be made."}
            {errorCode === "conflict" && errorRoomName && ` (${errorRoomName})`}
          </p>
        )
      }

      <h2 id="book">Book a room</h2>
      <form method="post" action="/api/bookings" aria-labelledby="book">
        <div class="field">
          <label for="roomId">Room</label>
          <select id="roomId" name="roomId" required>
            {
              rooms.map((room) => (
                <option value={room.id} selected={errorRoomId === String(room.id)}>
                  {room.name}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="pod">Pod</label>
          <input
            id="pod"
            name="pod"
            required
            maxlength="80"
            placeholder="e.g. Dachi"
            value={resubmitPod}
          />
        </div>
        <div class="field">
          <label for="tutor">Tutor</label>
          <input
            id="tutor"
            name="tutor"
            maxlength="80"
            placeholder="optional"
            value={resubmitTutor}
          />
        </div>
        <div class="field">
          <label for="startsAt">Starts</label>
          <input
            id="startsAt"
            name="startsAt"
            type="datetime-local"
            required
            value={resubmitStartsAt}
          />
        </div>
        <div class="field">
          <label for="endsAt">Ends</label>
          <input id="endsAt" name="endsAt" type="datetime-local" required value={resubmitEndsAt} />
        </div>
        <button>Book the room</button>
      </form>

      <h2>Schedule</h2>
      {
        bookings.length === 0 ? (
          <p>No bookings yet.</p>
        ) : (
          <div class="table-scroll" tabindex="0" role="region" aria-label="Schedule">
            <table>
              <thead>
                <tr>
                  <th scope="col">Room</th>
                  <th scope="col">Pod</th>
                  <th scope="col">Tutor</th>
                  <th scope="col">Starts</th>
                  <th scope="col">Ends</th>
                  <th scope="col">Calendar</th>
                </tr>
              </thead>
              <tbody id="schedule">
                {/* tr.past dims a finished booking, but colour alone can't be the
                    only way to tell — WCAG 1.4.1, and axe-core has no rule that
                    catches it since it can't judge what a colour means. The text
                    suffix below is the real signal; the dimming is just a bonus
                    for a sighted skim. */}
                {bookings.map((booking) => {
                  const isPast = booking.endsAt < nowLocal();
                  return (
                    <tr class={isPast ? "past" : undefined}>
                      <td>{booking.roomName}</td>
                      <td>{booking.pod}</td>
                      <td>{booking.tutor ?? "—"}</td>
                      <td>{booking.startsAt.replace("T", " ")}</td>
                      <td>
                        {booking.endsAt.replace("T", " ")}
                        {isPast && " (past)"}
                      </td>
                      <td>
                        <a href={`/api/calendar/${booking.id}`} download>
                          .ics<span class="visually-hidden"> for {booking.pod} in {booking.roomName}</span>
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }

      <h2 id="live-heading">Just booked</h2>
      <p>New bookings from other tabs appear here as they happen.</p>
      <ul id="live" aria-labelledby="live-heading" aria-live="polite"></ul>
    </main>
    {/* "<" escaped so a pod name can't close this script element early */}
    <script
      is:inline
      type="application/json"
      id="board-data"
      set:html={JSON.stringify(boardData).replace(/</g, "\\u003c")}
    />
    <script>
      import {
        type BoardBooking,
        nowLocal,
        nowPosition,
        roomStatus,
        statusText,
        suggestSlot,
        timelineBlocks,
      } from "../lib/board";

      const all: BoardBooking[] = JSON.parse(
        document.querySelector("#board-data")?.textContent ?? "[]",
      );

      // Re-derives every card from the same pure functions the server used,
      // so the board never drifts from what a reload would show.
      function render() {
        const now = nowLocal();
        const today = now.slice(0, 10);
        const nowAt = nowPosition(now);
        let free = 0;
        const cards = document.querySelectorAll<HTMLElement>("#board .card");
        for (const card of cards) {
          const roomId = Number(card.dataset.roomId);
          const name = card.querySelector("h3")?.textContent ?? "";
          const mine = all.filter((b) => b.roomId === roomId);
          const status = roomStatus(mine, now);
          if (status.state === "free") free++;
          card.classList.toggle("free", status.state === "free");
          card.classList.toggle("busy", status.state === "busy");
          const text = card.querySelector(".status-text");
          if (text) text.textContent = statusText(status, now);

          const timeline = card.querySelector<HTMLElement>(".timeline");
          if (timeline) {
            const blocks = timelineBlocks(mine, today);
            timeline.replaceChildren(
              ...blocks.map((b) => {
                const el = document.createElement("span");
                el.className = "block";
                el.style.left = `${b.left}%`;
                el.style.width = `${b.width}%`;
                el.title = b.label;
                return el;
              }),
            );
            if (nowAt !== undefined) {
              const marker = document.createElement("span");
              marker.className = "now";
              marker.style.left = `${nowAt}%`;
              timeline.append(marker);
            }
            timeline.setAttribute(
              "aria-label",
              `Today's bookings for ${name}: ${blocks.length ? blocks.map((b) => b.label).join(", ") : "none"}`,
            );
          }

          const link = card.querySelector<HTMLAnchorElement>(".book-link");
          if (link) {
            const slot = suggestSlot(mine, now);
            link.href = `/?${new URLSearchParams({ roomId: String(roomId), ...slot })}#book`;
          }
        }
        const summary = document.querySelector("#free-summary");
        if (summary) {
          const strong = document.createElement("strong");
          strong.textContent = `${free} of ${cards.length}`;
          summary.replaceChildren(strong, ` rooms free at ${now.slice(11, 16)}`);
        }
      }

      // The live half of the app: every other tab hears about a new booking
      // over SSE — it lands in "Just booked" and re-lights the board.
      const live = document.querySelector("#live");
      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const booking = JSON.parse(event.data);
        all.push(booking);
        render();
        const card = document.querySelector<HTMLElement>(`#board .card[data-room-id="${booking.roomId}"]`);
        card?.classList.remove("flash");
        void card?.offsetWidth;
        card?.classList.add("flash");
        const item = document.createElement("li");
        item.textContent = `${booking.roomName}: ${booking.pod}, ${booking.startsAt.replace("T", " ")}–${booking.endsAt.replace("T", " ")}`;
        live?.prepend(item);
      });

      setInterval(render, 30_000);
    </script>
  </body>
</html>
